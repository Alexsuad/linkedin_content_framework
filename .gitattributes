# File: .gitattributes
# ──────────────────────────────────────────────────────────────────────
# Propósito: Mantener saltos de línea consistentes en el repositorio.
# Este proyecto se trabaja principalmente en WSL/Linux, por eso los
# archivos de texto deben mantenerse con finales de línea LF.
# ──────────────────────────────────────────────────────────────────────

* text=auto eol=lf

*.md text eol=lf
*.py text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
